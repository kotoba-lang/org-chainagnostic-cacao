{:paths ["src"]
 ;; ed25519 / dag-cbor are pinned as git deps (not :local/root) so cacao
 ;; resolves standalone when consumed as a git dep from a clean clone with no
 ;; monorepo siblings present (ADR-2607022400). SHAs are each sibling repo's
 ;; origin/main HEAD as of 2026-07-02, obtained via
 ;;   gh api repos/kotoba-lang/<repo>/commits/main --jq .sha
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; The covering relation `covers?`/`verify-chain` attenuate against.
        ;; Not part of CAIP-122 -- resource covering is this fleet's extension,
        ;; and it is one partial order shared with every other consumer rather
        ;; than a substring test repeated per scheme.
        io.github.kotoba-lang/authority
        {:git/url "https://github.com/kotoba-lang/authority.git"
         :git/sha "2de205a778f4744a42c609abcc70c989449c2852"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "e96c4d0390b3f7d7c29f981e17ab666e16dc0fe0"}
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git"
         :git/sha "de18ad29102f9df150e214d756de4719c3c00d7a"}}
 :aliases {;; Monorepo-local dev: resolve the siblings from the working-tree
           ;; checkouts (../org-ietf-ed25519, ../org-ietf-cbor) instead of git.
           ;; Compose with other aliases, e.g. `kbb -M:local:test`.
           ;; Preserves the pre-existing sibling-checkout workflow without
           ;; breaking clean git-dep consumption above.
           :local {:override-deps {io.github.kotoba-lang/authority {:local/root "../authority"}
                                   io.github.kotoba-lang/org-ietf-ed25519  {:local/root "../org-ietf-ed25519"}
                                   io.github.kotoba-lang/org-ietf-cbor {:local/root "../org-ietf-cbor"}}}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                               ;; The Kotoba compiler and KIR interpreter, so
                               ;; `kotoba/siwe/window.kotoba` is driven by the
                               ;; suite rather than described by it.
                               io.github.kotoba-lang/amu
                               {:git/url "https://github.com/kotoba-lang/amu.git"
                                :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                               io.github.kotoba-lang/osaho
                               {:git/url "https://github.com/kotoba-lang/osaho.git"
                                :git/sha "56911149694ddaa382ce7d214ed62c69a2d917c5"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
           ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}
